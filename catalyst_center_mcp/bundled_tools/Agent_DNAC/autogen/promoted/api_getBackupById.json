{
  "function": {
    "_meta": {
      "agents": [
        "catalyst_network_engineer_agent"
      ],
      "release_status": "SMO_APR_2026"
    },
    "additionalMetadata": {
      "method": "GET",
      "parameterLocation": {
        "id": "path"
      },
      "uri": "/dna/system/api/v1/backups/{id}",
      "version": "1.0.0-oas3"
    },
    "description": "**Pick this tool for ONE specific backup when you already know the backup ID.**\n\nThis tool retrieves the full details for a specific backup by backup UUID, including installed packages, versions, compatibility errors, storage details, size, dates, and restore compatibility.\n\n**Use this tool when the user asks:**\n- for full details of one known backup\n- what packages or versions are included in a backup\n- whether a specific backup is compatible for restore\n- when a specific backup was created and by whom\n- for the storage or scope details of a specific backup\n\n**Pick this tool for questions like:**\n- \"Show details for backup <id>\"\n- \"What packages are in backup <id>?\"\n- \"Is backup <id> compatible for restore?\"\n- \"When was backup <id> created?\"\n- \"Show me everything about backup <id>\"\n\n**Do NOT use this tool for:**\n- discovering which backups exist\n- listing all backups or failed backups\n- backup execution history\n\nThis is the detail view for a known backup. If the identifier is unknown, call `api_getAllBackup` first to obtain the backup `id`.",
    "name": "api_getBackupById",
    "parameters": {
      "properties": {
        "id": {
          "description": "Required backup UUID to inspect. Obtain this value from the `id` field returned by `api_getAllBackup`.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "responses": {
      "description": "Contains the information about backup details.",
      "properties": {
        "response": {
          "allOf": [
            {
              "description": "Contains the information about backup details..",
              "properties": {
                "compatibilityError": {
                  "description": "The backup compatibility error",
                  "items": {
                    "description": "Contains the information about backup compatibility.",
                    "properties": {
                      "endDate": {
                        "description": "Backup compatibility end date",
                        "example": "2022-04-30T02:21:22.000Z",
                        "type": "string"
                      },
                      "namespace": {
                        "description": "The namespace of the service",
                        "example": "sys-ops",
                        "type": "string"
                      },
                      "response": {
                        "additionalProperties": true,
                        "description": "Response received from the service during compatibility check",
                        "type": "object"
                      },
                      "serviceName": {
                        "description": "The service name on which the compatibility check executed",
                        "example": "admin-service",
                        "type": "string"
                      },
                      "startDate": {
                        "description": "Backup compatibility start date",
                        "example": "2022-04-30T02:21:22.000Z",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "context": {
                  "allOf": [
                    {
                      "description": "Contains the information about backup context..",
                      "properties": {
                        "schedule": {
                          "description": "Schedule time",
                          "example": "2022-04-30T02:21:22.000Z",
                          "type": "string"
                        },
                        "type": {
                          "description": "This states whether the backup is created based on schedule or on-demand",
                          "enum": [
                            "ONDEMAND",
                            "SCHEDULE"
                          ],
                          "example": "ONDEMAND",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  ],
                  "description": "This field states whether the backup is on-demand or schedule based",
                  "type": "object"
                },
                "createdBy": {
                  "description": "This field represents the user who triggered this backup",
                  "example": "2022-04-30T02:21:22.000Z",
                  "type": "string"
                },
                "createdDate": {
                  "description": "This field represents the backup creation date",
                  "example": "2022-04-30T02:21:22.000Z",
                  "type": "string"
                },
                "duration": {
                  "description": "Total time taken to create this backup",
                  "example": 12345,
                  "type": "integer"
                },
                "endDate": {
                  "description": "This field represents the backup end date",
                  "example": "2022-04-30T02:21:22.000Z",
                  "type": "string"
                },
                "fipsEnabled": {
                  "description": "This states whether FIPS is enabled or not",
                  "example": true,
                  "type": "boolean"
                },
                "id": {
                  "description": "The UUID for this backup",
                  "example": "6dbd446d-77b4-4cd4-8514-5dbe675a0ea4",
                  "type": "string"
                },
                "installedPackages": {
                  "description": "List of packages installed",
                  "items": {
                    "description": "Contains the information about installed packages during backup creation.",
                    "properties": {
                      "displayName": {
                        "description": "The package display name",
                        "example": "Cisco DNAC Platform Events",
                        "type": "string"
                      },
                      "name": {
                        "description": "The package name",
                        "example": "dnacaap-events",
                        "type": "string"
                      },
                      "version": {
                        "description": "The package version",
                        "example": "1.1.1",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "internetProtocolVersion": {
                  "description": "The network protocol",
                  "enum": [
                    "ipv4",
                    "ipv6"
                  ],
                  "example": "ipv4",
                  "type": "string"
                },
                "isBackupAvailable": {
                  "description": "This field represents whether the backup is available in the configured storage",
                  "example": true,
                  "type": "boolean"
                },
                "isCompatible": {
                  "description": "This field represents whether the backup is compatible to restore",
                  "example": true,
                  "type": "boolean"
                },
                "name": {
                  "description": "The backup name",
                  "example": "System Backup",
                  "type": "string"
                },
                "numberOfNodes": {
                  "description": "Total number of nodes",
                  "example": 1,
                  "type": "integer"
                },
                "productType": {
                  "description": "Installed product type",
                  "example": "dnac",
                  "type": "string"
                },
                "productVersion": {
                  "description": "The product version",
                  "example": "1.2.32",
                  "type": "string"
                },
                "releaseDisplayName": {
                  "description": "The release display name of the product installed",
                  "example": "Bristol release 1.1.1",
                  "type": "string"
                },
                "releaseDisplayVersion": {
                  "description": "The release display version of the product installed",
                  "example": "1.1.0",
                  "type": "string"
                },
                "releaseName": {
                  "description": "The release name of the product installed",
                  "example": "bristol-release-1.1.1",
                  "type": "string"
                },
                "releaseVersion": {
                  "description": "The release version of the product installed",
                  "example": "1.1.1",
                  "type": "string"
                },
                "scope": {
                  "description": "The backup scope states whether the backup is with assurance or without assurance data",
                  "enum": [
                    "CISCO_DNA_DATA_WITH_ASSURANCE",
                    "CISCO_DNA_DATA_WITHOUT_ASSURANCE"
                  ],
                  "example": "CISCO_DNA_DATA_WITH_ASSURANCE",
                  "type": "string"
                },
                "size": {
                  "description": "The total backup size",
                  "example": 323233,
                  "type": "integer"
                },
                "status": {
                  "description": "Status of the backup",
                  "example": "IN_PROGRESS",
                  "type": "string"
                },
                "storage": {
                  "allOf": [
                    {
                      "description": "Contains backup storage information.",
                      "properties": {
                        "host": {
                          "description": "The host of the storage",
                          "example": "10.12.1.12",
                          "type": "string"
                        },
                        "id": {
                          "description": "The UUID of the storage",
                          "example": "6dbd446d-77b4-4cd4-8514-5dbe675a0ea4",
                          "type": "string"
                        },
                        "mountPath": {
                          "description": "The mount path of the storage",
                          "example": "/sda1/",
                          "type": "string"
                        },
                        "name": {
                          "description": "The name of the storage",
                          "example": "NFS Host 1",
                          "type": "string"
                        },
                        "serverPath": {
                          "description": "The server path of the storage",
                          "example": "/root/backup/",
                          "type": "string"
                        },
                        "type": {
                          "description": "The type pf storage",
                          "enum": [
                            "PHYSICAL_DISK",
                            "NFS"
                          ],
                          "example": "NFS",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  ],
                  "description": "The storage detail of the backup",
                  "type": "object"
                },
                "versions": {
                  "description": "List of packages available while creating the backup",
                  "example": [
                    "1.1.1",
                    "1.1.2"
                  ],
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          ],
          "description": "Contains information about backup.",
          "type": "object"
        },
        "version": {
          "description": "The version of the response",
          "example": "1.1.0",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "type": "function"
}
