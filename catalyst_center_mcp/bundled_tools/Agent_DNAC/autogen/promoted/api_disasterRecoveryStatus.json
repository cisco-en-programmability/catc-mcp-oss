      "agents": [
        "catalyst_network_engineer_agent"
      ]
    },
    "additionalMetadata": {
      "method": "GET",
      "parameterLocation": {},
      "uri": "/dna/intent/api/v1/disasterrecovery/system/status",
      "version": "2.3.7.9"
    },
    "description": "Detailed and Summarized status of DR components (Active, Standby and Witness system's health). ",
