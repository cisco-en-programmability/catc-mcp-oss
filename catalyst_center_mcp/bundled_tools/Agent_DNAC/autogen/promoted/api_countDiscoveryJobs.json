          "description": "The id of the discovery.",
          "type": "string"
        },
        "jobId": {
          "description": "Optional list of the discovery job ids to filter by.",
          "example": [
            "1739936077107",
            "17399360774307"
          ],
          "items": {
            "type": "string"
          },
          "maxItems": 25,
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "responses": {
      "description": "Reports a count, for example, a total count of records in a given resource.",
      "properties": {
        "response": {
          "properties": {
            "count": {
              "description": "The reported count.",
              "example": 15,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "version": {
          "description": "The version of the response",
          "example": "1.0",
