      "parameterLocation": {
        "id": "path"
      },
      "uri": "/dna/intent/api/v1/featureTemplates/wireless/multicastConfigurations/{id}",
      "version": "2.3.7.9"
    },
    "description": "This API allows users to retrieve a specific Multicast configuration feature template by ID.",
    "name": "api_getMulticastConfigurationFeatureTemplate",
    "parameters": {
      "properties": {
        "id": {
          "description": "Multicast Configuration Feature Template Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "responses": {
      "description": "",
      "properties": {
        "response": {
          "description": "Multicast Configuration Response",
          "properties": {
            "designName": {
              "description": "The feature template design name",
              "type": "string"
            },
            "featureAttributes": {
              "description": "Multicast Configuration Feature Template",
              "properties": {
                "globalMulticastEnabled": {
                  "description": "Global Multicast Enabled.",
                  "type": "boolean"
                },
                "multicastAddress": {
                  "description": "Multicast address must be between 224.0.0.0 - 239.255.255.255. `Note:` multicastAddress is only supported for `MULTICAST` multicastMode.",
