                  "type": "string"
                }
              },
              "type": "object"
            },
            "id": {
              "description": "ID of the Multicast configuration feature template",
              "type": "string"
            },
            "unlockedAttributes": {
              "description": "attributes unlocked in design can be changed at device provision time. `Note:` unlockedAttributes can only contain the attributes defined under featureAttributes.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "version": {
          "description": "Version",
          "type": "string"
        }
