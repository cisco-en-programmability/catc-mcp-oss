{
  "function": {
    "_meta": {
      "agents": [
        "catalyst_network_engineer_agent"
      ]
    },
    "additionalMetadata": {
      "method": "GET",
      "parameterLocation": {
        "id": "path"
      },
      "uri": "/dna/intent/api/v1/featureTemplates/wireless/aaaRadiusAttributesConfigurations/{id}",
      "version": "2.3.7.9"
    },
    "description": "This API allows users to retrieve a specific AAA Radius Attributes configuration feature template by ID.",
    "name": "api_getAAARadiusAttributesConfigurationFeatureTemplate",
    "parameters": {
      "properties": {
        "id": {
          "description": "AAA Radius Attributes Configuration Feature Template Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "responses": {
      "description": "",
      "properties": {
        "response": {
          "description": "AAA Radius Attributes Configuration Response",
          "properties": {
            "designName": {
              "description": "The feature template design name. `Note:` The following characters are not allowed % & < > [ ] ' /",
              "type": "string"
            },
            "featureAttributes": {
              "description": "AAA Radius Attributes Configuration Feature Attributes",
              "properties": {
                "calledStationId": {
                  "description": "Called Station Identifier (calledStationId)",
                  "enum": [
                    "AP_ETHMAC_ONLY",
                    "AP_ETHMAC_SSID",
                    "AP_GROUP_NAME",
                    "AP_LABEL_ADDRESS",
                    "AP_LABEL_ADDRESS_SSID",
                    "AP_LOCATION",
                    "AP_MACADDRESS",
                    "AP_MACADDRESS_SSID",
                    "AP_NAME",
                    "AP_NAME_SSID",
                    "IPADDRESS",
                    "MACADDRESS",
                    "VLAN_ID"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            },
            "id": {
              "description": "id of the AAA Radius Attributes configuration feature template",
              "type": "string"
            },
            "unlockedAttributes": {
              "description": "attributes unlocked in design can be changed at device provision time. `Note:` unlockedAttributes can only contain the attributes defined under featureAttributes.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "version": {
          "description": "Version",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "type": "function"
}
