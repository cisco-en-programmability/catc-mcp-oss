          "type": "string"
        },
        "failureReason": {
          "description": "Reason for failure when a client fails to meet the threshold.\nExamples:\n`failureReason=MOBILITY_FAILURE` (single ssid requested)\n`failureReason=REASON_IPLEARN_CONNECT_TIMEOUT&failureReason=ST_EAP_TIMEOUT`   (multiple ssid requested)\n",
          "type": "string"
        },
